{
  "name": "attune-meta",
  "version": "0.1.0",
  "private": true,
  "description": "Planning branch for Attune: constitution, OpenSpec specs and changes, handoffs, release evidence.",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "agents:sync": "node scripts/agents-sync.mjs sync",
